# =====================================================================
# Plantilla de configuracion externa - Aplicacion Web Restaurante (Equipo 5)
# Copie este archivo como ".env" en la carpeta Restaurante/ y complete
# los valores reales de su base de datos (Neon o PostgreSQL local).
# NUNCA incluya el archivo ".env" real en entregas ni repositorios.
# =====================================================================

# Controlador ODBC de PostgreSQL instalado en el equipo
# En Windows suele ser: PostgreSQL Unicode(x64)
ODBC_DRIVER=PostgreSQL Unicode(x64)

# Datos del servidor PostgreSQL
# Para Neon use el host de su proyecto (ej: ep-xxxxx.us-east-2.aws.neon.tech)
# Para PostgreSQL local use: localhost
DB_HOST=tu-servidor-postgres.ejemplo.com
DB_PORT=5432
DB_NAME=neondb

# Para Neon use: require
# Para PostgreSQL local sin SSL use: prefer (o disable)
DB_SSLMODE=require

# Tiempo maximo de espera al conectar (segundos)
DB_TIMEOUT=6

# Usuarios fijos creados en vistas_permisos_equipo5.sql
# Las contrasenas se asignan en PostgreSQL con ALTER ROLE ... PASSWORD '...';
DB_USER_CONSULTA=app_consulta
DB_PASS_CONSULTA=CAMBIAR_CLAVE_CONSULTA

DB_USER_OPERACION=app_operacion
DB_PASS_OPERACION=CAMBIAR_CLAVE_OPERACION

# Clave de sesion de Flask (puede ser cualquier cadena aleatoria local)
FLASK_SECRET_KEY=cambiar-por-clave-local-de-sesion
FLASK_PORT=5000
